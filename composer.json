{
    "name": "projectjoker/craft-alt-extend",
    "description": "Appends or prepends a configurable text to image alt attributes in Craft CMS",
    "type": "craft-plugin",
    "keywords": ["craft", "cms", "craftcms", "alt", "seo", "accessibility"],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Joker",
            "homepage": "https://project-joker.com"
        }
    ],
    "support": {
        "issues": "https://github.com/project-joker/craft-alt-extend/issues",
        "source": "https://github.com/project-joker/craft-alt-extend"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "projectjoker\\altextend\\": "src/"
        }
    },
    "extra": {
        "name": "Alt Extend",
        "handle": "alt-extend",
        "class": "projectjoker\\altextend\\Plugin",
        "developer": "Project Joker",
        "developerUrl": "https://project-joker.com",
        "documentationUrl": "https://github.com/project-joker/craft-alt-extend/blob/main/README.md",
        "description": "Appends or prepends a configurable text to image alt attributes"
    }
}
